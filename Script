-- MOVE TO STAND
-- ═══════════════════════════════════════════════════════════
moveButton.MouseButton1Click:Connect(function()
    if state.activeTween then
        state.activeTween:Cancel()
        state.activeTween = nil
    end

    local character = localPlayer.Character
    if not character then return end

    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    local targetCFrame = CFrame.new(
        544.577637,
        92.0762939,
        -364.869049,
        -1, 0, 0,
        0, 1, 0,
        0, 0, -1
    )

    local tweenInfo = TweenInfo.new(7, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, 0, false, 0)

    state.activeTween = TweenService:Create(rootPart, tweenInfo, {
        CFrame = targetCFrame,
    })

    stopButton.Visible = true

    state.activeTween.Completed:Connect(function()
        stopButton.Visible = false
        state.activeTween = nil
    end)

    state.activeTween:Play()
end)

stopButton.MouseButton1Click:Connect(function()
    if state.activeTween then
        state.activeTween:Cancel()
        state.activeTween = nil
    end
    stopButton.Visible = false
end)

