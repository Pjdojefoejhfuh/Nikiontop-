-- BYPASS (toggle)
-- ═══════════════════════════════════════════════════════════
bypassButton.MouseButton1Click:Connect(function()
    local character = localPlayer.Character
    if not character then return end

    if state.bypassActive then
        state.bypassActive = false
        bypassButton.Text = "BYPASS ANTI-CHEAT : OFF"
        bypassButton.BackgroundColor3 = Color3.fromRGB(8, 8, 8)

        if state.originalHumanoid and state.originalHumanoid.Parent then
            pcall(function() state.originalHumanoid:Destroy() end)
        end

        local existingHumanoid = character:FindFirstChildOfClass("Humanoid")
        if existingHumanoid then existingHumanoid:Destroy() end

        local newHumanoid = Instance.new("Humanoid")
        newHumanoid.Parent = character
        state.originalHumanoid = newHumanoid
    else
        state.bypassActive = true
        bypassButton.Text = "BYPASS ANTI-CHEAT : ON"
        bypassButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)

        local oldHumanoid = character:FindFirstChildOfClass("Humanoid")
        if oldHumanoid then
            state.originalHumanoid = oldHumanoid
            oldHumanoid:Destroy()
        end

        local replacementHumanoid = Instance.new("Humanoid")
        replacementHumanoid.Parent = character
    end
end)

