-- =========================================================
-- TEXT
-- =========================================================

local function cleanText(raw)
    if not raw then return "" end
    local text = tostring(raw)
    text = text:gsub("<[^>]+>", "")
    text = text:gsub("^%s+", "")
    text = text:gsub("%s+$", "")
    return text
end

local function isDebounced(text)
    local last = seenAt[text]
    if last and os.clock() - last < DEBOUNCE_SECONDS then
        return true
    end
    return false
end

-- =========================================================
-- PROGRESS
-- =========================================================

local function updateProgressBar(count, total)
    if not progressFill then return end
    local pct = math.clamp(count / math.max(total, 1), 0, 1)
    TweenService:Create(
        progressFill,
        TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = UDim2.new(pct, 0, 1, 0) }
    ):Play()
end

local function resetCapture()
    capturedParts = {}
    updateProgressBar(0, submitAfter)
    if isActive and sniperStatus then
        sniperStatus.Text = "awaiting codes..."
        sniperStatus.TextColor3 = getAccent()
    end
    addLog("» Capture reset", C.Silver3)
end

-- =========================================================
-- CAPTURE
-- =========================================================

local function handleNewText(text, isSimulated)
    if not isActive then return end

    text = cleanText(text)
    if #text < 1 or #text > 50 then return end
    if isDebounced(text) then return end

    seenAt[text] = os.clock()
    openCodesGui()

    capturedParts[#capturedParts + 1] = text
    local fullText = table.concat(capturedParts)
    local count = #capturedParts

    sniperStatus.Text = count .. "/" .. submitAfter .. ": " .. fullText
    sniperStatus.TextColor3 = getAccent()
    updateProgressBar(count, submitAfter)

    addLog("◈ DETECTED \"" .. text .. "\"  (" .. count .. "/" .. submitAfter .. ")", C.GoldBright)

    showAnnouncement(text, player.UserId, player.DisplayName)

    local box = findTextBox()
    if box then
        box:CaptureFocus()
        box.Text = fullText
        addLog("✎ WROTE \"" .. fullText .. "\" to code box", C.Cyan)
    else
        addLog("⚠ Code box not found", C.Orange)
    end

    if count >= submitAfter and autoSubmit then
        capturedParts = {}
        sniperStatus.Text = "redeeming..."
        sniperStatus.TextColor3 = C.Cyan
        updateProgressBar(0, submitAfter)

        addLog("⏵ Submitting \"" .. fullText .. "\"...", C.Cyan)

        task.spawn(function()
            task.wait(0.12 + math.random() * 0.1)
            local ok = false
            local codesGui = playerGui:FindFirstChild("Codes")
            if codesGui then
                for _, btn in pairs(codesGui:GetDescendants()) do
                    if btn:IsA("TextButton") and (btn.Text == "Submit" or btn.Text == "Redeem" or btn.Text == "Redeem Code") then
                        pcall(function()
                            btn:Activate()
                            ok = true
                        end)
                        break
                    end
                end
            end
            if not ok then
                pcall(function()
                    local vim = game:GetService("VirtualInputManager")
                    vim:SendKeyEvent(true, Enum.KeyCode.Return, false, nil)
                    vim:SendKeyEvent(false, Enum.KeyCode.Return, false, nil)
                end)
            end

            sniperStatus.Text = ok and "redeemed!" or "failed - try reset"
            sniperStatus.TextColor3 = ok and C.Green or C.Red

            if ok then
                addLog("✔ REDEEMED \"" .. fullText .. "\"", C.Green)
            else
                addLog("✖ FAILED \"" .. fullText .. "\"", C.Red)
            end

            task.wait(0.6 + math.random() * 0.2)
            if isActive then
                sniperStatus.Text = "awaiting codes..."
                sniperStatus.TextColor3 = getAccent()
            end
        end)
    end
end

