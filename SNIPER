        task.delay(0.18, function()
            if simBtn then
                TweenService:Create(simBtn, TweenInfo.new(0.25), {BackgroundColor3 = original}):Play()
            end
        end)
        simInput.Text = ""
    end

    simBtn.MouseButton1Click:Connect(fireSim)
    simInput.FocusLost:Connect(function(enterPressed)
        if enterPressed then fireSim() end
    end)

    settingsPanel = createSettingsPanel(main)

    settingsBtn.MouseButton1Click:Connect(function()
        settingsOpen = not settingsOpen
        settingsPanel.Visible = settingsOpen
    end)

    task.defer(function()
        addLog("» Nova Sniper ready", C.Green)
        addLog("» Awaiting codes...", C.Silver2)
    end)

    return sg, setActiveVisual
end

-- =========================================================
-- GUI HOOK
-- =========================================================

local function hookGui(gui)
    local function scanExisting()
        for _, el in pairs(gui:GetDescendants()) do
            if el:IsA("TextLabel") and el.Visible and el.Text ~= "" then
                oldTexts[cleanText(el.Text)] = true
            end
        end
    end

    scanExisting()

    gui.DescendantAdded:Connect(function(el)
        if not el:IsA("TextLabel") then return end

        local function tryCapture()
            if el.Parent and el.Visible and el.Text ~= "" then
                local text = cleanText(el.Text)
                if #text > 0 then
                    handleNewText(text)
                end
            end
        end

        if el.Text ~= "" then tryCapture() end

        local conn
        conn = el:GetPropertyChangedSignal("Text"):Connect(function()
            tryCapture()
        end)

        el.AncestryChanged:Connect(function(_, parent)
            if not parent and conn then
                conn:Disconnect()
            end
        end)
    end)
end

local function hookAllowedGuis()
    for _, guiName in ipairs(ALLOWED_GUIS) do
        local gui = playerGui:FindFirstChild(guiName)
        if gui and gui:IsA("ScreenGui") then
            hookGui(gui)
        else
            playerGui.ChildAdded:Connect(function(child)
                if child.Name == guiName and child:IsA("ScreenGui") then
                    hookGui(child)
                end
            end)
        end
    end
end

