    shadow.Position = UDim2.new(0, -12, 0, -8)
    shadow.BackgroundColor3 = Color3.new(0, 0, 0)
    shadow.BackgroundTransparency = 0.5
    shadow.BorderSizePixel = 0
    shadow.ZIndex = -1
    shadow.Parent = parent
    createCorner(shadow, (radius or 18) + 6)
    return shadow
end

