-- AUTO BUY
-- =========================================================
local AB = { enabled = false, running = false, conn = nil, promptCache = {} }

local function isPromptValid(prompt)
    if not (prompt and prompt:IsA("ProximityPrompt")) then return false end
    local parent = prompt.Parent
    if not parent or parent.Name ~= "PromptAttachment" then return false end
    local parent2 = parent.Parent
    if not parent2 or parent2.Name ~= "Part" then return false end
    return true
end

local function getPromptPosition(prompt)
    if not prompt then return nil end
    local parent = prompt.Parent
    if parent and parent:IsA("Attachment") and parent.Name == "PromptAttachment" then
        local part = parent.Parent
        if part and part:IsA("BasePart") then return part.Position end
    end
    return nil
end

local function isPromptOnScreen(prompt)
    local pos = getPromptPosition(prompt)
    if not pos then return false end
    local _, onScreen = workspace.CurrentCamera:WorldToViewportPoint(pos)
    return onScreen
end

local function holdPrompt(prompt)
    if not prompt then return end
    pcall(function() prompt:InputHoldBegin() end)
end

local function releasePrompt(prompt)
    if not prompt then return end
    pcall(function() prompt:InputHoldEnd() end)
end

local function cachePrompt(prompt)
    if isPromptValid(prompt) and not AB.promptCache[prompt] then
        AB.promptCache[prompt] = true
    end
end

local function startAutoBuy()
    if AB.running then return end
    AB.running = true
    for _, obj in ipairs(Workspace:GetDescendants()) do cachePrompt(obj) end
    if AB.conn then AB.conn:Disconnect() end
    AB.conn = Workspace.DescendantAdded:Connect(cachePrompt)

    task.spawn(function()
        while AB.running and AB.enabled do
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                for prompt, _ in pairs(AB.promptCache) do
                    if prompt and prompt.Parent and isPromptValid(prompt) then
                        local pos = getPromptPosition(prompt)
                        if pos then
                            local dist = (root.Position - pos).Magnitude
                            local onScreen = isPromptOnScreen(prompt)
                            if dist > 15 or not onScreen then
                                releasePrompt(prompt)
                            else
                                holdPrompt(prompt)
                            end
                        end
                    else
                        AB.promptCache[prompt] = nil
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end

local function stopAutoBuy()
    AB.running = false
    if AB.conn then AB.conn:Disconnect(); AB.conn = nil end
    for prompt, _ in pairs(AB.promptCache) do
        pcall(function() releasePrompt(prompt) end)
    end
    AB.promptCache = {}
end

