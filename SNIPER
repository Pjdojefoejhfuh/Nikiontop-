local SETTINGS_FILE = "NovaSniper_Settings.json"

local Settings = {
    autoSubmit = true,
    submitAfter = 3,
    theme = "Gold",
    accentR = 255,
    accentG = 195,
    accentB = 50,
    shineEnabled = true,
}

local function loadSettings()
    pcall(function()
        if isfile and isfile(SETTINGS_FILE) then
            local data = HttpService:JSONDecode(readfile(SETTINGS_FILE))
            if type(data) == "table" then
                if data.autoSubmit ~= nil then Settings.autoSubmit = data.autoSubmit end
                if data.submitAfter ~= nil then Settings.submitAfter = data.submitAfter end
                if data.theme ~= nil then Settings.theme = data.theme end
                if data.accentR ~= nil then Settings.accentR = data.accentR end
                if data.accentG ~= nil then Settings.accentG = data.accentG end
                if data.accentB ~= nil then Settings.accentB = data.accentB end
                if data.shineEnabled ~= nil then Settings.shineEnabled = data.shineEnabled end
            end
        end
    end)
end

local function saveSettings()
    pcall(function()
        if writefile then
            writefile(SETTINGS_FILE, HttpService:JSONEncode(Settings))
        end
    end)
end

loadSettings()

