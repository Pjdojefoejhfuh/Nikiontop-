-- =========================================================
-- TEXT / UTILS
-- =========================================================
local function cleanText(raw)
    if not raw then return "" end
    local text = tostring(raw)
    text = text:gsub("<[^>]+>", "")
    text = text:gsub("^%s+", "")
    text = text:gsub("%s+$", "")
    return text
end

local function isDebounced(text)
    local last = seenAt[text]
    if last and os.clock() - last < DEBOUNCE_SECONDS then return true end
    return false
end-- =========================================================
-- PROGRESS / RESET
-- =========================================================
local function updateProgressBar(count, total)
    if not skProgressBar then return end
    local pct = math.clamp(count / math.max(total, 1), 0, 1) * 100
    skProgressBar.Update(pct)
end

local function resetCapture()
    capturedParts = {}
    updateProgressBar(0, submitAfter)
    if isActive and skStatusLabel then
        skStatusLabel.SetText("awaiting codes...")
    end
    addLog("» Capture reset", C.Silver3)
end

-- =========================================================
-- CAPTURE
-- =========================================================
local function handleNewText(text, isSimulated)
    if not isActive then return end

    text = cleanText(text)
    if #text < 1 or #text > 50 then return end
    if isDebounced(text) then return end

    seenAt[text] = os.clock()
    openCodesGui()

    capturedParts[#capturedParts + 1] = text
    local fullText = table.concat(capturedParts)
    local count = #capturedParts

    if skStatusLabel then
        skStatusLabel.SetText(count .. "/" .. submitAfter .. ": " .. fullText)
    end
    updateProgressBar(count, submitAfter)
    addLog("◈ DETECTED \"" .. text .. "\"  (" .. count .. "/" .. submitAfter .. ")", C.GoldBright)
    showAnnouncement(text, player.UserId, player.DisplayName)

    local box = findTextBox()
    if box then
        box:CaptureFocus()
        box.Text = fullText
        addLog("✎ WROTE \"" .. fullText .. "\" to code box", C.Cyan)
    else
        addLog("⚠ Code box not found", C.Orange)
    end

    if count >= submitAfter and autoSubmit then
        capturedParts = {}
        if skStatusLabel then skStatusLabel.SetText("redeeming...") end
        updateProgressBar(0, submitAfter)
        addLog("⏵ Submitting \"" .. fullText .. "\"...", C.Cyan)

        task.spawn(function()
            task.wait(0.12 + math.random() * 0.1)
            local ok = false
            local codesGui = playerGui:FindFirstChild("Codes")
            if codesGui then
                for _, btn in pairs(codesGui:GetDescendants()) do
                    if btn:IsA("TextButton")
                    and (btn.Text == "Submit"
                      or btn.Text == "Redeem"
                      or btn.Text == "Redeem Code") then
                        pcall(function() btn:Activate(); ok = true end)
                        break
                    end
                end
            end
            if not ok then
                pcall(function()
                    local vim = game:GetService("VirtualInputManager")
                    vim:SendKeyEvent(true,  Enum.KeyCode.Return, false, nil)
                    vim:SendKeyEvent(false, Enum.KeyCode.Return, false, nil)
                end)
            end

            if skStatusLabel then
                skStatusLabel.SetText(ok and "redeemed!" or "failed - try reset")
            end
            addLog(ok and ("✔ REDEEMED \"" .. fullText .. "\"")
                     or ("✖ FAILED \"" .. fullText .. "\""),
                   ok and C.Green or C.Red)

            hookCodeRedeemed(fullText, ok, count)

            task.wait(0.6 + math.random() * 0.2)
            if isActive and skStatusLabel then
                skStatusLabel.SetText("awaiting codes...")
            end
        end)
    end
end

