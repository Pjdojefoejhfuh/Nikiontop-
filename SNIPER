    return image
end

local function findUserIdFromText(text)
    if not text or text == "" then return player.UserId end
    text = text:gsub("^@", "")
    text = text:gsub("%s+", "")
    if text == "" then return player.UserId end
    if string.lower(text) == string.lower(player.Name) then
        return player.UserId
    end
    -- Cherche dans les joueurs actuels d'abord
    for _, p in ipairs(Players:GetPlayers()) do
        if string.lower(p.Name) == string.lower(text) or string.lower(p.DisplayName) == string.lower(text) then
            return p.UserId
        end
    end
    local found
    pcall(function()
        found = Players:GetUserIdFromNameAsync(text)
    end)
    return found or player.UserId
end

