-- =========================================================
local _lastRightShift = 0
trackConn(UserInputService.InputBegan:Connect(function(input, gpe)
    if unloaded then return end
    if gpe then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        local now = os.clock()
        if now - _lastRightShift < 0.25 then return end
        _lastRightShift = now

        isActive = not isActive
        if skToggleActive then pcall(function() skToggleActive.Set(isActive) end) end
        refreshTopBarActive()
        if isActive then
            resetCapture()
            addLog("» Sniper ACTIVATED (hotkey)", C.Green)
        else
            if skStatusLabel then skStatusLabel.SetText("paused") end
            addLog("» Sniper PAUSED (hotkey)", C.Red)
        end
        hookSniperToggle(isActive)
    end
end))

