local function updateMusicProgress()
    if not skMusicProgressBar or not musicState.sound then
        if skMusicProgressBar then skMusicProgressBar.Update(0, true) end
        return
    end
    local t = musicState.sound.TimePosition or 0
    local len = musicState.sound.TimeLength or 0
    if len > 0 then
        skMusicProgressBar.Update(math.clamp(t / len, 0, 1) * 100, true)
    end
end

task.spawn(function()
    while not unloaded do
        task.wait(0.5)
        if musicState.sound and musicState.playing and not musicState.paused then
            updateMusicProgress()
        end
    end
end)

local function stopMusic()
    if musicState.sound then
        pcall(function() musicState.sound:Stop() end)
        pcall(function() musicState.sound:Destroy() end)
        musicState.sound = nil
    end
    musicState.playing = false
    musicState.paused = false
    musicState.currentIdx = nil
    if skNowPlayingLabel then pcall(function() skNowPlayingLabel.SetText("No music") end) end
    if skMusicProgressBar then pcall(function() skMusicProgressBar.Update(0, true) end) end
end

local function playMusic(idx)
    local song = Songs[idx]
    if not song then return end
    if musicState.sound then
        pcall(function() musicState.sound:Stop() end)
        pcall(function() musicState.sound:Destroy() end)
        musicState.sound = nil
    end
    local snd = Instance.new("Sound")
    snd.Name = "NovaSniperMusic"
    snd.SoundId = song.Id
    snd.Looped = true
    snd.Volume = musicState.volume
    snd.PlaybackSpeed = musicState.speed
    snd.Parent = SoundService
    musicState.sound = snd
    musicState.playing = true
    musicState.paused = false
    musicState.currentIdx = idx
    snd:Play()
    if skNowPlayingLabel then
        pcall(function() skNowPlayingLabel.SetText("▶ " .. song.Name) end)
    end
    addLog("♪ Playing " .. song.Name, C.Cyan)
end

local function togglePlayPause()
    if not musicState.sound then return end
    if musicState.paused then
        musicState.sound:Resume()
        musicState.paused = false
        if skNowPlayingLabel then
            pcall(function() skNowPlayingLabel.SetText("▶ " .. Songs[musicState.currentIdx].Name) end)
        end
    else
        musicState.sound:Pause()
        musicState.paused = true
        if skNowPlayingLabel then
            pcall(function() skNowPlayingLabel.SetText("⏸ " .. Songs[musicState.currentIdx].Name) end)
        end
    end
end

local function setVolume(v)
    musicState.volume = math.clamp(v / 100, 0, 1)
    Settings.musicVolume = musicState.volume
    saveSettings()
    if musicState.sound then musicState.sound.Volume = musicState.volume end
end

local function setSpeed(speed)
    musicState.speed = speed
    Settings.musicSpeed = speed
    saveSettings()
    if musicState.sound then musicState.sound.PlaybackSpeed = speed end
    if skSpeedLabel then
        pcall(function() skSpeedLabel.SetText(string.format("Speed: %.2fx", speed)) end)
    end
end

