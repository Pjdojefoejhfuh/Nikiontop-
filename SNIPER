-- =========================================================
local antiRagdollEnabled = false
local antiRagdollConns = {}

local function applyAntiRagdoll(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        hum.PlatformStand = false
        hum.AutoRotate = true
        hum.BreakJointsOnDeath = false
        hum.RequiresNeck = false
    end)

    table.insert(antiRagdollConns, RunService.Heartbeat:Connect(function()
        if not antiRagdollEnabled then return end
        if not hum or not hum.Parent then return end
        if hum.PlatformStand then hum.PlatformStand = false end
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.FallingDown then
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end))
end

local function startAntiRagdoll()
    if antiRagdollEnabled then return end
    antiRagdollEnabled = true
    local char = player.Character
    if char then applyAntiRagdoll(char) end
    table.insert(antiRagdollConns, player.CharacterAdded:Connect(function(newChar)
        task.wait(0.3)
        if antiRagdollEnabled then applyAntiRagdoll(newChar) end
    end))
end

local function stopAntiRagdoll()
    antiRagdollEnabled = false
    for _, c in ipairs(antiRagdollConns) do pcall(function() c:Disconnect() end) end
    antiRagdollConns = {}
end

