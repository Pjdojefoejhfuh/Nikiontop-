local ThemePresets = {
    Gold   = Color3.fromRGB(255, 195, 50),
    Purple = Color3.fromRGB(180, 100, 255),
    Cyan   = Color3.fromRGB(60, 210, 230),
    Red    = Color3.fromRGB(255, 70, 90),
    Green  = Color3.fromRGB(60, 230, 100),
    Pink   = Color3.fromRGB(255, 100, 180),
}

local function getAccent()
    return Color3.fromRGB(Settings.accentR, Settings.accentG, Settings.accentB)
end

local function setAccent(c)
    Settings.accentR = math.floor(c.R * 255 + 0.5)
    Settings.accentG = math.floor(c.G * 255 + 0.5)
    Settings.accentB = math.floor(c.B * 255 + 0.5)
    saveSettings()
    local accent = getAccent()
    for _, s in ipairs(themeObjects.strokes) do
        pcall(function() s.Color = accent end)
    end
    for _, t in ipairs(themeObjects.textColors) do
        pcall(function() t.TextColor3 = accent end)
    end
    for _, g in ipairs(themeObjects.grads) do
        pcall(function()
            g.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, accent),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
                ColorSequenceKeypoint.new(1, accent),
            })
        end)
    end
end

local function registerStroke(s)
    if not s then return s end
    table.insert(themeObjects.strokes, s)
    s.Color = getAccent()
    return s
end

local function registerText(t)
    if not t then return t end
    table.insert(themeObjects.textColors, t)
    t.TextColor3 = getAccent()
    return t
end

local function registerGrad(g)
    if not g then return g end
    table.insert(themeObjects.grads, g)
    local accent = getAccent()
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, accent),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(1, accent),
    })
    return g
end

