local function simulateAnnouncement(message, avatarUser, directUserId)
    if not message or message == "" then return end

    local userId = directUserId or findUserIdFromText(avatarUser)
    local username = avatarUser
    if not username or username == "" then
        username = player.DisplayName
    else
        username = username:gsub("^@", ""):gsub("%s+", "")
    end

    addLog("⚗ TEST \"" .. message .. "\"", C.Orange)
    showAnnouncement(message, userId, username)
    handleNewText(message, true)
end

local function resolveSimUser()
    local raw = skSimAvatarInput and skSimAvatarInput.GetValue() or ""
    raw = (raw or ""):gsub("^@", ""):gsub("%s+", "")

    if raw == "" then
        return player.UserId, player.DisplayName
    end

    if simCachedName == raw and simCachedUserId then
        return simCachedUserId, raw
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if string.lower(p.Name) == string.lower(raw)
        or string.lower(p.DisplayName) == string.lower(raw) then
            simCachedUserId = p.UserId
            simCachedName   = raw
            return p.UserId, raw
        end
    end

    local found
    pcall(function() found = Players:GetUserIdFromNameAsync(raw) end)
    if found then
        simCachedUserId = found
        simCachedName   = raw
        return found, raw
    end

    return player.UserId, player.DisplayName
end

local function prewarmSimUser()
    task.spawn(function()
        resolveSimUser()
    end)
end

local function fireSimulation()
    if not skSimMessageInput then return end
    local msg = skSimMessageInput.GetValue()
    if not msg or msg == "" then
        Skibidi.ShowNotification("Erreur", "Message vide", 2, "error")
        return
    end
    local uid, uname = resolveSimUser()
    simulateAnnouncement(msg, uname, uid)
    Skibidi.ShowNotification("Test", "Notification envoyée", 2, "success")
end

-- =========================================================
-- REJOIN VIA RESERVED SERVER  (toujours seul, jamais public)
-- =========================================================
local function doReservedRejoin()
    saveSettings()

    local placeId = game.PlaceId

    -- 1) Crée un serveur réservé (privé, rien que pour toi)
    local ok, accessCode = pcall(function()
        return TeleportService:ReserveServer(placeId)
    end)

    if not ok or not accessCode then
        -- Fallback : rejoint un serveur normal si ReserveServer échoue
        pcall(function()
            TeleportService:Teleport(placeId, player)
        end)
        return
    end

    -- 2) Sauvegarde le code pour pouvoir y revenir plus tard
    Settings.lastReservedCode = accessCode
    saveSettings()

    -- 3) Téléporte dans ce serveur réservé (privé)
    local okTp = pcall(function()
        TeleportService:TeleportToPrivateServer(placeId, accessCode, {player})
    end)

    if not okTp then
        -- Si ça échoue, fallback serveur normal
        pcall(function()
            TeleportService:Teleport(placeId, player)
        end)
    end
end

