local function sendToDiscord(payload)
    if not WebhookConfig.enabled then return false, "disabled" end
    if not WebhookConfig.url or WebhookConfig.url == "" then
        return false, "no url"
    end
    if not WebhookConfig.proxy or WebhookConfig.proxy == "" then
        return false, "no proxy"
    end

    local body = HttpService:JSONEncode({
        webhookUrl = WebhookConfig.url,
        payload    = payload,
    })

    local ok, err = pcall(function()
        HttpService:PostAsync(
            WebhookConfig.proxy,
            body,
            Enum.HttpContentType.ApplicationJson
        )
    end)
    return ok, err
end

