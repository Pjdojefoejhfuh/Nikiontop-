-- =========================================================
-- CONFIG SYSTEM (save / load / copy / import)
-- =========================================================
local CONFIG_FOLDER = "NovaSniper_Configs"
local CONFIG_INDEX  = "NovaSniper_Configs/index.json"

local function ensureConfigFolder()
    pcall(function()
        if isfolder and not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
    end)
    pcall(function()
        if isfile and not isfile(CONFIG_INDEX) then writefile(CONFIG_INDEX, "[]") end
    end)
end

local function getConfigList()
    ensureConfigFolder()
    local list = {}
    pcall(function()
        if isfile and isfile(CONFIG_INDEX) then
            local raw = readfile(CONFIG_INDEX)
            if raw and raw ~= "" then
                local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
                if ok and type(data) == "table" then list = data end
            end
        end
    end)
    return list
end

local function saveConfigList(list)
    pcall(function() writefile(CONFIG_INDEX, HttpService:JSONEncode(list)) end)
end

local function buildConfigData(name)
    return {
        name = name or "Unnamed",
        date = os.date("%Y-%m-%d %H:%M:%S"),
        version = "v5.0",
        settings = {
            autoSubmit   = Settings.autoSubmit,
            submitAfter  = Settings.submitAfter,
            theme        = Settings.theme,
            accentR      = Settings.accentR,
            accentG      = Settings.accentG,
            accentB      = Settings.accentB,
            shineEnabled = Settings.shineEnabled,
            simHotkey    = Settings.simHotkey,
            musicVolume  = Settings.musicVolume,
            musicSpeed   = Settings.musicSpeed,
            keySound     = Settings.keySound,
            topBarScale  = Settings.topBarScale,
        },
    }
end

local function applyConfigData(data)
    if type(data) ~= "table" then return false end
    local s = data.settings
    if type(s) ~= "table" then return false end
    for k, v in pairs(s) do
        if Settings[k] ~= nil then Settings[k] = v end
    end
    saveSettings()
    pcall(function()
        if s.autoSubmit ~= nil then autoSubmit = s.autoSubmit end
        if s.submitAfter ~= nil then submitAfter = s.submitAfter end
        if s.simHotkey then simHotkey = Enum.KeyCode[s.simHotkey] or Enum.KeyCode.T end
        if s.accentR and s.accentG and s.accentB then
            setAccent(Color3.fromRGB(s.accentR, s.accentG, s.accentB))
        end
        if s.musicVolume then
            musicState.volume = s.musicVolume
            if musicState.sound then musicState.sound.Volume = s.musicVolume end
        end
        if s.musicSpeed then
            musicState.speed = s.musicSpeed
            if musicState.sound then musicState.sound.PlaybackSpeed = s.musicSpeed end
            if skSpeedLabel then skSpeedLabel.SetText(string.format("Speed: %.2fx", s.musicSpeed)) end
        end
    end)
    return true
end

local function saveConfigAsNew(name)
    if not name or name == "" then name = "Config_" .. os.time() end
    ensureConfigFolder()

    local safeName = name:gsub("[^%w_%-]", "_")
    local filename = CONFIG_FOLDER .. "/" .. safeName .. ".json"
    local data = buildConfigData(name)
    pcall(function() writefile(filename, HttpService:JSONEncode(data)) end)

    local list = getConfigList()
    local found = false
    for _, item in ipairs(list) do
        if item.name == name then
            item.date = data.date
            item.file = filename
            found = true
            break
        end
    end
    if not found then
        table.insert(list, { name = name, date = data.date, file = filename })
    end
    saveConfigList(list)
    return true, filename
end

local function loadConfigByName(name)
    ensureConfigFolder()
    local list = getConfigList()
    for _, item in ipairs(list) do
        if item.name == name and item.file then
            local ok = false
            pcall(function()
                if isfile(item.file) then
                    local raw = readfile(item.file)
                    local data = HttpService:JSONDecode(raw)
                    ok = applyConfigData(data)
                end
            end)
            return ok
        end
    end
    return false
end

local function deleteConfigByName(name)
    ensureConfigFolder()
    local list = getConfigList()
    local newList = {}
    for _, item in ipairs(list) do
        if item.name == name then
            pcall(function() if isfile(item.file) then delfile(item.file) end end)
        else
