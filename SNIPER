-- UNLOAD
-- =========================================================
function doUnload()
    if unloaded then return end
    unloaded = true
    isActive = false

    pcall(stopAntiDie)
    pcall(stopMusic)

    for _, c in ipairs(unloadConnections) do
        pcall(function() c:Disconnect() end)
    end
    unloadConnections = {}

    pcall(function() Skibidi.Unload() end)

    if activeAnnouncement then
        pcall(function() activeAnnouncement:Destroy() end)
        activeAnnouncement = nil
    end

    for _, g in ipairs(playerGui:GetChildren()) do
        if g:IsA("ScreenGui")
        and (g.Name:match("^Notif_") or g.Name:match("^Main_") or g.Name:match("^Loading_")) then
            pcall(function() g:Destroy() end)
        end
    end

    for _, s in ipairs(SoundService:GetChildren()) do
        if s:IsA("Sound")
        and (s.Name == "NovaSniperMusic"
          or s.Name == "NovaKeySound"
          or s.SoundId == "rbxassetid://12221967") then
            pcall(function() s:Destroy() end)
        end
    end

    print("🟡 NOVA SNIPER — Unloaded.")
end

-- =========================================================
-- GUI HOOK
-- =========================================================
local function hookGui(gui)
    local function scanExisting()
        for _, el in pairs(gui:GetDescendants()) do
            if el:IsA("TextLabel") and el.Visible and el.Text ~= "" then
                oldTexts[cleanText(el.Text)] = true
            end
        end
    end
    scanExisting()

    trackConn(gui.DescendantAdded:Connect(function(el)
        if not el:IsA("TextLabel") then return end
        local function tryCapture()
            if el.Parent and el.Visible and el.Text ~= "" then
                local text = cleanText(el.Text)
                if #text > 0 then handleNewText(text) end
            end
        end
        if el.Text ~= "" then tryCapture() end
        local conn
        conn = el:GetPropertyChangedSignal("Text"):Connect(tryCapture)
        el.AncestryChanged:Connect(function(_, parent)
            if not parent and conn then conn:Disconnect() end
        end)
    end))
end

local function hookAllowedGuis()
    for _, guiName in ipairs(ALLOWED_GUIS) do
        local gui = playerGui:FindFirstChild(guiName)
        if gui and gui:IsA("ScreenGui") then
            hookGui(gui)
        else
            trackConn(playerGui.ChildAdded:Connect(function(child)
                if child.Name == guiName and child:IsA("ScreenGui") then
                    hookGui(child)
                end
            end))
        end
    end
end

