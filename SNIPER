-- ANTI-LAG (7UP STYLE) — extrême
-- =========================================================
local antiLagEnabled = false
local antiLagConns = {}
local antiLagSnapshot = {
    effects = {}, parts = {}, decals = {},
    lighting = nil, quality = nil, meshDetail = nil,
    terrain = nil, postEffects = {}, skybox = nil, fov = nil,
}

local function saveLightingSnapshot()
    antiLagSnapshot.lighting = {
        GlobalShadows = Lighting.GlobalShadows,
        Brightness = Lighting.Brightness,
        Ambient = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient,
        FogEnd = Lighting.FogEnd,
        FogStart = Lighting.FogStart,
        FogColor = Lighting.FogColor,
        EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
        EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
        ExposureCompensation = Lighting.ExposureCompensation,
    }
end

local function restoreLightingSnapshot()
    if not antiLagSnapshot.lighting then return end
    pcall(function()
        Lighting.GlobalShadows = antiLagSnapshot.lighting.GlobalShadows
        Lighting.Brightness = antiLagSnapshot.lighting.Brightness
        Lighting.Ambient = antiLagSnapshot.lighting.Ambient
        Lighting.OutdoorAmbient = antiLagSnapshot.lighting.OutdoorAmbient
        Lighting.FogEnd = antiLagSnapshot.lighting.FogEnd
        Lighting.FogStart = antiLagSnapshot.lighting.FogStart
        Lighting.FogColor = antiLagSnapshot.lighting.FogColor
        Lighting.EnvironmentDiffuseScale = antiLagSnapshot.lighting.EnvironmentDiffuseScale
        Lighting.EnvironmentSpecularScale = antiLagSnapshot.lighting.EnvironmentSpecularScale
        Lighting.ExposureCompensation = antiLagSnapshot.lighting.ExposureCompensation
    end)
    antiLagSnapshot.lighting = nil
end

local function stripEffects()
    for _, obj in ipairs(game:GetDescendants()) do
        pcall(function()
            if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke")
            or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Beam")
            or obj:IsA("Highlight") or obj:IsA("SelectionBox") or obj:IsA("SelectionSphere") then
                if antiLagSnapshot.effects[obj] == nil then antiLagSnapshot.effects[obj] = obj.Enabled end
                obj.Enabled = false
            elseif obj:IsA("Explosion") then
                obj.BlastPressure = 0
                obj.BlastRadius = 0
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                if antiLagSnapshot.decals[obj] == nil then antiLagSnapshot.decals[obj] = obj.Transparency end
                obj.Transparency = 1
            elseif obj:IsA("PostEffect") then
                if antiLagSnapshot.postEffects[obj] == nil then antiLagSnapshot.postEffects[obj] = obj.Enabled end
                obj.Enabled = false
            elseif obj:IsA("BasePart") then
                if antiLagSnapshot.parts[obj] == nil then
                    antiLagSnapshot.parts[obj] = {
                        Material = obj.Material, Reflectance = obj.Reflectance,
                        Transparency = obj.Transparency, CastShadow = obj.CastShadow,
                    }
                end
                obj.Material = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
                obj.CastShadow = false
            elseif obj:IsA("Sky") then
                if antiLagSnapshot.skybox == nil then
                    antiLagSnapshot.skybox = {
                        SkyboxBk = obj.SkyboxBk, SkyboxDn = obj.SkyboxDn,
                        SkyboxFt = obj.SkyboxFt, SkyboxLf = obj.SkyboxLf,
                        SkyboxRt = obj.SkyboxRt, SkyboxUp = obj.SkyboxUp,
                        StarCount = obj.StarCount,
                    }
                end
                obj.SkyboxBk = ""; obj.SkyboxDn = ""; obj.SkyboxFt = ""
                obj.SkyboxLf = ""; obj.SkyboxRt = ""; obj.SkyboxUp = ""
                obj.StarCount = 0
            end
        end)
    end
end

local function applyAntiLag()
    saveLightingSnapshot()
    stripEffects()

    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.Brightness = 0
        Lighting.Ambient = Color3.fromRGB(80, 80, 80)
        Lighting.OutdoorAmbient = Color3.fromRGB(80, 80, 80)
        Lighting.FogEnd = 200
        Lighting.FogStart = 50
        Lighting.FogColor = Color3.fromRGB(60, 60, 60)
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        Lighting.ExposureCompensation = -1
    end)

    pcall(function()
        antiLagSnapshot.quality = settings().Rendering.QualityLevel
        antiLagSnapshot.meshDetail = settings().Rendering.MeshPartDetail
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        settings().Rendering.MeshPartDetail = Enum.MeshDetailLevel.Level01
        settings().Rendering.SavedQualityLevel = Enum.SavedQualitySetting.AutomaticLowGraphics
    end)

    pcall(function()
        local cam = workspace.CurrentCamera
        if cam then
            antiLagSnapshot.fov = cam.FieldOfView
            cam.FieldOfView = 60
        end
    end)

    pcall(function()
        local terrain = workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            antiLagSnapshot.terrain = {
                WaterWaveSize = terrain.WaterWaveSize,
                WaterWaveSpeed = terrain.WaterWaveSpeed,
                WaterTransparency = terrain.WaterTransparency,
                WaterReflectance = terrain.WaterReflectance,
            }
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterTransparency = 1
            terrain.WaterReflectance = 0
            terrain.Decoration = false
        end
    end)

    pcall(function()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character then
                for _, obj in ipairs(plr.Character:GetDescendants()) do
                    if obj:IsA("Accessory") or obj:IsA("Shirt") or obj:IsA("Pants")
                    or obj:IsA("ShirtGraphic") or obj:IsA("CharacterMesh") then
                        if obj:IsA("BasePart") then obj.Transparency = 1
                        elseif obj:IsA("Decal") then obj.Transparency = 1 end
                    end
                end
            end
        end
    end)
end

local function startAntiLag()
    if antiLagEnabled then return end
    antiLagEnabled = true
    applyAntiLag()

    table.insert(antiLagConns, Workspace.DescendantAdded:Connect(function(obj)
        if not antiLagEnabled then return end
        pcall(function()
            if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke")
            or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Beam")
            or obj:IsA("Highlight") then
                obj.Enabled = false
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = 1
            elseif obj:IsA("BasePart") then
                obj.Material = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
                obj.CastShadow = false
            end
        end)
    end))

    table.insert(antiLagConns, Lighting.ChildAdded:Connect(function(obj)
        if not antiLagEnabled then return end
        if obj:IsA("PostEffect") then obj.Enabled = false end
    end))

    table.insert(antiLagConns, Players.PlayerAdded:Connect(function(plr)
        plr.CharacterAdded:Connect(function(char)
            if not antiLagEnabled then return end
            task.wait(0.5)
            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("Accessory") or obj:IsA("Shirt") or obj:IsA("Pants")
                or obj:IsA("ShirtGraphic") or obj:IsA("CharacterMesh") then
                    pcall(function()
                        if obj:IsA("BasePart") then obj.Transparency = 1
                        elseif obj:IsA("Decal") then obj.Transparency = 1 end
                    end)
                end
            end
        end)
    end))
end

local function stopAntiLag()
    antiLagEnabled = false
    for _, c in ipairs(antiLagConns) do pcall(function() c:Disconnect() end) end
    antiLagConns = {}

    pcall(function()
        for obj, val in pairs(antiLagSnapshot.effects) do
            if obj and obj.Parent then obj.Enabled = val end
        end
    end)
    antiLagSnapshot.effects = {}

    pcall(function()
        for obj, val in pairs(antiLagSnapshot.decals) do
            if obj and obj.Parent then obj.Transparency = val end
        end
    end)
    antiLagSnapshot.decals = {}

    pcall(function()
        for obj, data in pairs(antiLagSnapshot.parts) do
            if obj and obj.Parent then
                obj.Material = data.Material
                obj.Reflectance = data.Reflectance
                obj.Transparency = data.Transparency
                obj.CastShadow = data.CastShadow
            end
        end
    end)
    antiLagSnapshot.parts = {}

    pcall(function()
        for obj, val in pairs(antiLagSnapshot.postEffects) do
            if obj and obj.Parent then obj.Enabled = val end
        end
    end)
    antiLagSnapshot.postEffects = {}

    pcall(function()
        local sky = Lighting:FindFirstChildOfClass("Sky")
        if sky and antiLagSnapshot.skybox then
            sky.SkyboxBk = antiLagSnapshot.skybox.SkyboxBk
            sky.SkyboxDn = antiLagSnapshot.skybox.SkyboxDn
            sky.SkyboxFt = antiLagSnapshot.skybox.SkyboxFt
            sky.SkyboxLf = antiLagSnapshot.skybox.SkyboxLf
            sky.SkyboxRt = antiLagSnapshot.skybox.SkyboxRt
