-- =========================================================
-- LEAVE ON STEAL
-- =========================================================
local LEAVE_ENABLED = false
local leaveKicked = false
local leaveConns = {}
local leaveStarted = false

local STEAL_VERBS = { "stole", "stoled", "stolen", "stealing", "steal", "stealed" }

local function isYouStealMessage(text)
    if type(text) ~= "string" then return false end
    local low = string.lower(text)
    low = low:gsub("^[%s%p]+", "")
    low = low:gsub("%s+", " ")
    if #low < 8 or #low > 200 then return false end
    for _, verb in ipairs(STEAL_VERBS) do
        if string.find(low, "^you " .. verb, 1, true) then return true end
        if string.find(low, "^you just " .. verb, 1, true) then return true end
        if string.find(low, "^you have " .. verb, 1, true) then return true end
        if string.find(low, "^you've " .. verb, 1, true) then return true end
        if string.find(low, "^you are " .. verb, 1, true) then return true end
    end
    return false
end

local function isFalsePositive(text)
    if type(text) ~= "string" then return true end
    local low = string.lower(text)
    if string.find(low, "your ", 1, true) then return true end
    if string.find(low, "you got ", 1, true) then return true end
    if string.find(low, "you were ", 1, true) then return true end
    if string.find(low, "you lost", 1, true) then return true end
    if string.find(low, "was stolen", 1, true) then return true end
    if string.find(low, "has been stolen", 1, true) then return true end
    if string.find(low, "stole your", 1, true) then return true end
    if string.find(low, "stoled your", 1, true) then return true end
    if string.find(low, "stealing your", 1, true) then return true end
    return false
end

local function hasStealText(text)
    if isFalsePositive(text) then return false end
    return isYouStealMessage(text)
end

local function leaveOnSteal(detectedText)
    if not LEAVE_ENABLED then return end
    if leaveKicked then return end
    leaveKicked = true
    print("[Leave on Steal] Kick:", detectedText)
    pcall(function() player:Kick("Leave on Steal") end)
end

local function isLabelOnScreen(label)
    if not label or not label.Parent then return false end
    if not label.Visible then return false end
    local p = label
    while p and p ~= playerGui do
        if p:IsA("GuiObject") and not p.Visible then return false end
        p = p.Parent
    end
    local size = label.AbsoluteSize
    if size.X < 10 or size.Y < 10 then return false end
    if label.TextTransparency > 0.95 then return false end
    return true
end

local function watchObject(obj)
    if not obj or unloaded then return end
    if not (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then return end
    local c = obj:GetPropertyChangedSignal("Text"):Connect(function()
        if not LEAVE_ENABLED or leaveKicked then return end
        if not isLabelOnScreen(obj) then return end
        if hasStealText(obj.Text) then leaveOnSteal(obj.Text) end
    end)
    table.insert(leaveConns, c)
end

local function setupGuiWatcher(gui)
    if not gui then return end
    local c = gui.DescendantAdded:Connect(watchObject)
    table.insert(leaveConns, c)
end

local function startLeaveWatcher()
    if leaveStarted then return end
    leaveStarted = true
    task.spawn(function()
        task.wait(8)
        if unloaded then return end
        local c1 = playerGui.ChildAdded:Connect(setupGuiWatcher)
        table.insert(leaveConns, c1)
        for _, gui in ipairs(playerGui:GetChildren()) do setupGuiWatcher(gui) end
        pcall(function()
            local TCS = game:GetService("TextChatService")
            if TCS then
                local cc = TCS.MessageReceived:Connect(function(msg)
                    if not LEAVE_ENABLED or leaveKicked then return end
                    if hasStealText(tostring(msg.Text or "")) then leaveOnSteal(msg.Text) end
                end)
                table.insert(leaveConns, cc)
            end
        end)
    end)
end

startLeaveWatcher()

