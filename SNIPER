local function simulateAnnouncement(message, avatarUser)
    if not message or message == "" then return end

    local userId = findUserIdFromText(avatarUser)
    local username = avatarUser
    if not username or username == "" then
        username = player.DisplayName
    else
        username = username:gsub("^@", "")
        username = username:gsub("%s+", "")
    end

    addLog("⚗ TEST \"" .. message .. "\"", C.Orange)
    showAnnouncement(message, userId, username)
    handleNewText(message, true)
end

