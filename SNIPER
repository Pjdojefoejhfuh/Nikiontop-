    for i = 1, veinCount or 10 do
        local vein = Instance.new("Frame")
        vein.Size = UDim2.new(0, math.random(50, 140), 0, math.random(2, 5))
        vein.Position = UDim2.new(math.random() * 0.7, 0, math.random() * 0.8, 0)
